@using EntitiesFitness
@model List<Exercice>

<h1 class="text-center rounded-3 text-light btn-color2 p-4">Liste d'exercices</h1>
<div>
    <br/>
    <a role="button" class="btn btn-success" asp-controller="Exercice" asp-action="CreateExercice">
        + Créer un exercice
    </a>
</div>
<br/>
<table class="table">
    <thead>
        <tr class="table-dark">
            <th scope="col" class="btn-color4 text-black">Nom</th>
            <th scope="col" class="btn-color4 text-black">Muscle</th>
            <th scope="col" class="btn-color4 text-black text-center">Répétition</th>
            <th scope="col" class="btn-color4 text-black text-center">Poids(kg)</th>
            <th scope="col" class="btn-color4 text-black"></th>
            <th scope="col" class="btn-color4 text-black"></th>
            <th scope="col" class="btn-color4 text-black"></th>
        </tr>
    </thead>
    <tbody>
        @foreach (Exercice e in Model)
        {
        <tr>
            <td scope="row" class="text-white">@e.NomExercice.Nom</td>
            <td class ="text-white">@e.NomExercice.Muscle.Nom</td>
            <td class="text-white text-center">@e.Serie.Rep</td>
            <td class="text-white text-center">@e.Serie.Poids</td>
            <td><a role="button" class="btn btn-primary" asp-action="EditExercice" asp-route-id="@e.NomExerciceId">Modifier</a></td>
            <td><a role="button" class="btn btn-secondary" asp-action="DetailExercice" asp-route-id="@e.NomExerciceId">Detail</a></td>
            <td>
                <form asp-action="DeleteExercice" method="post">
                    <input type="hidden" name="Id" asp-for="@e.Id" />
                    <button type="submit" class="btn btn-danger" onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet exercice ?')">Supprimer</button>
                </form>
            </td>
        </tr> 
        }
    </tbody>
</table>
