@using EntitiesFitness
@model List<Exercice>

<h1 class="text-center rounded-3 text-light bg-dark p-4">Detail @ViewBag.NomExo</h1>

<div class="p-4 border rounded btn-color4">
    <h4>@ViewBag.nomExo</h4>
    @foreach (Exercice e in Model)
    {
        <div>
            <dl class="row">
                <dt class="col-sm-2">Date</dt>
                <dd class="col-sm-10">@e.Date</dd>
                <dt class="col-sm-2">Poids</dt>
                <dd class="col-sm-10">@e.Serie.Poids</dd>
                <dt class="col-sm-2">Répétitions</dt>
                <dd class="col-sm-10">@e.Serie.Rep</dd>
            </dl>
        </div>
    }
    <a class="btn btn-primary" role="button" asp-action="ListeExercice">
        <i class="bi bi-arrow-return-left"></i> retour
    </a>
    <button class="btn btn-secondary" onclick="window.print()">
        <i class="bi bi-trash"></i> Imprimer
    </button>
</div>