@using EntitiesFitness
@using EntityFitness.MyEntities
@model List<Seance>
@{
    Exercice nom = new Exercice();
    Serie serie = new Serie();
}
<h1 class ="text-center text-light bg-dark p-4">Page DetailSeance</h1>
<h1 class="text-white">@Model[1].NomSeance.Nom</h1>
<br/>
    @for (int i = 0; i < Model.Count; i++)
    {
        if (i == 0)
        {
        nom = Model[i].Exercice;
        <table class="table">
            <thead>
                <tr>
                    <h4 class="text-white">@Model[i].Exercice.NomExercice.Nom</h4>
                    <th scope="col" class="text-white">Id</th>
                    <th scope="col" class="text-white">Date</th>
                    <th scope="col" class="text-white">Poids</th>
                    <th scope="col" class="text-white">Rep</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-white">@Model[i].Exercice.Serie.Id</td>
                    <td class="text-white">@Model[i].Exercice.Date</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Poids</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Rep</td>
                </tr>
                @if (Model[i].Exercice.NomExerciceId == Model[i++].Exercice.NomExerciceId)
                {
                    @for (int n = 1; n < Model.Count; n++)
                    {
                        if (Model[i].Exercice.NomExerciceId == Model[n].Exercice.NomExerciceId)
                        {
                            <tr>
                                <td class="text-white">@Model[n].Exercice.Serie.Id</td>
                                <td class="text-white">@Model[n].Exercice.Date</td>
                                <td class="text-white">@Model[n].Exercice.Serie.Poids</td>
                                <td class="text-white">@Model[n].Exercice.Serie.Rep</td>
                            </tr>
                        }
                    }
                }
            </tbody>
        </table>
        }else
        {
        <table class="table">
            <thead>
                <tr>
                    <h4 class="text-white">@Model[i].Exercice.NomExercice.Nom</h4>
                    <th scope="col" class="text-white">Id</th>
                    <th scope="col" class="text-white">Date</th>
                    <th scope="col" class="text-white">Poids</th>
                    <th scope="col" class="text-white">Rep</th>
                </tr>
            </thead>
            <tbody>
                <tr>
                    <td class="text-white">@Model[i].Exercice.Serie.Id</td>
                    <td class="text-white">@Model[i].Exercice.Date</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Poids</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Rep</td>
                </tr>
                @if (i++ != null) 
                {
                    @if (Model[i].Exercice.NomExerciceId == Model[i++].Exercice.NomExerciceId)
                    {
                        @for (int n = i; n < Model.Count; n++)
                        {
                            if (Model[i].Exercice.NomExerciceId == Model[n++].Exercice.NomExerciceId)
                            {
                                <tr>
                                    <td class="text-white">@Model[n].Exercice.Serie.Id</td>
                                    <td class="text-white">@Model[n].Exercice.Date</td>
                                    <td class="text-white">@Model[n].Exercice.Serie.Poids</td>
                                    <td class="text-white">@Model[n].Exercice.Serie.Rep</td>
                                </tr>
                            }
                        }
                    }
                }
            </tbody>
        </table>
        }
    }
}