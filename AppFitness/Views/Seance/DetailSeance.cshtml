@using EntitiesFitness
@using EntityFitness.MyEntities
@model List<Seance>
@{
    Exercice exo = new Exercice();
    Exercice exo1 = new Exercice();
    DateTime date0 = new DateTime();
    DateTime date1 = new DateTime();
    DateTime date2 = new DateTime();
    DateTime date3 = new DateTime();
    List<DateTime> listeDate = new List<DateTime>();
    List<Exercice> listeExo = new List<Exercice>();
    Seance seance = new Seance();
    Seance seance1 = new Seance();
    List<Seance> listeSeance = new List<Seance>();
    List<Seance> original = Model.ToList();
    Serie MySerie = new Serie();
    bool doublon = false;
    int index = 0;
    int index1 = 0;
    int NomSId = Model[0].NomSeanceId;
}
<h1 class="text-center text-light bg-dark p-4">Séance @Model[0].NomSeance.Nom</h1>
<br/>
<div id="formModal" class="modal fade" tabindex="-1" role="dialog">
    <div class="modal-dialog modal-custom modal-dialog-centered">
        <div class="modal-content btn-color2" id="formContainer">
        </div>
    </div>
</div>
<div class="d-flex justify-content-between" style="margin-bottom: 20px;">
    <button role="button" class="btn btn-success" onclick="AddExo(@NomSId)">+ Ajouter un exercice</button>
    <button class="btn btn-secondary">Imprimer</button>
    <form asp-action="DeleteSeance" method="post">
        <input type="hidden" name="Nom" value="@Model[0].NomSeanceId" />
        <button role="button" class="btn btn-danger">Supprimer la séance "@Model[0].NomSeance.Nom"</button>
    </form>
</div>
<br/>
@for (int i = 0; i < Model.Count; i++)
{
    seance = new Seance();
    listeExo = new List<Exercice>();
    for (int a = 0; a < Model.Count; a++)
    {
        if (Model[i].Exercice.NomExerciceId == Model[a].Exercice.NomExerciceId)
        {
            exo = Model[a].Exercice;
            listeExo.Add(exo);
            listeExo.OrderBy(n => n.NomExerciceId)
                .ThenBy(d => d.Date)
                .ThenBy(ns => ns.NumSerie)
                .ToList();
        }
    }
    for (int j = 0; j < listeExo.Count; j++)
    {
        date0 = DateTime.Parse(listeExo[j].Date);
        listeDate.Add(date0);
        listeDate.OrderByDescending(d => d.Date).ToList();
    }
    index1 = listeDate.Count - 1;
    date1 = listeDate[index1].Date;
    for (int j = 0; j < listeExo.Count;)
    {
        date2 = DateTime.Parse(listeExo[j].Date);
        if (date1 != date2)
        {
            exo = listeExo[j];
            listeExo.Remove(exo);
        } else
        {
            j++;    
        }
    }
    seance = Model[i];
    doublon = listeSeance.Any(i => i.Exercice.NomExercice.Nom == seance.Exercice.NomExercice.Nom);
    @if (doublon == false)
    {
        listeSeance.Add(seance);
        <div class="d-flex justify-content-between align-items-center" style="margin-bottom: 15px;">
            <h4 class="text-white">@seance.Exercice.NomExercice.Nom</h4>
            <form asp-action="StartExercice" method="post">
                <input type="hidden" name="pageIndex" value="@Model[0].NomSeanceId" />
                <input type="hidden" name="NomExoId" value="@Model[i].Exercice.NomExerciceId" />
                <input type="hidden" name="Date" value="@Model[i].Exercice.Date" />
                <button class="btn btn-info">Commencer cet exercice</button>
            </form>
        </div>
        <table class="table btn-color3 text-center">
        <thead>
            <tr>
                <th scope="col" class="text-white">N° de série</th>
                <th scope="col" class="text-white">Dernière date</th>
                <th scope="col" class="text-white">Poids(kg)</th>
                <th scope="col" class="text-white">Rep</th>
                <th scope="col" class="text-white"></th>
                <th scope="col" class="text-white"></th>
            </tr>
        </thead>
        @for (int a = 0; a < listeExo.Count; a++)
        {
            seance1 = original.FirstOrDefault(e => e.ExerciceId == listeExo[a].Id);
            <tbody>
                <tr>
                    <td class="text-white">@listeExo[a].NumSerie</td>
                    <td class="text-white">@listeExo[a].Date</td>
                    <td class="text-white">@listeExo[a].Serie.Poids</td>
                    <td class="text-white">@listeExo[a].Serie.Rep</td>
                    <td>
                        <button class="btn btn-primary" 
                        onclick="openForm(@seance1.Id)">
                        Modifier</button>
                    </td>
                    <td>
                        <form asp-action="DeleteSerie" method="post">
                            <input type="hidden" name="SerieId" value="@listeExo[a].SerieId" />
                            <input type="hidden" name="pageIndex" value="@Model[0].NomSeanceId" />
                            <button role="button" class="btn btn-danger">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            </tbody>
        }
        @if (listeExo == null)
        {
            <tbody>
                <tr>
                    <td class="text-white">@Model[i].Exercice.NumSerie</td>
                    <td class="text-white">@Model[i].Exercice.Date</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Poids</td>
                    <td class="text-white">@Model[i].Exercice.Serie.Rep</td>
                    <td>
                        <button role="button" class="btn btn-primary"
                            onclick="openForm(@Model[i].Id)">
                            Modifier
                        </button>
                    </td>
                    <td>
                        <form asp-action="DeleteSerie" method="post">
                            <input type="hidden" name="SerieId" value="@Model[i].Exercice.SerieId"/>
                            <input type="hidden" name="pageIndex" value="@Model[0].NomSeanceId" />
                            <button role="button" class="btn btn-danger">
                                Supprimer
                            </button>
                        </form>
                    </td>
                </tr>
            </tbody>
        }
        </table>
        MySerie.Poids = Model[i].Exercice.Serie.Poids;
        MySerie.Rep = Model[i].Exercice.Serie.Rep;
        string d = date1.ToString("dd.MM.yyyy");
        <div class="d-flex gap-2" style="margin-bottom: 50px;">
        <form asp-controller="Seance" asp-action="AddSerie" method="post">
            <input type="hidden" name="pageIndex" value="@Model[Model.Count - 1].NomSeanceId" />
            <input type="hidden" name="NomExo" value="@seance.Exercice.NomExerciceId" />
            <input type="hidden" name="Poids" value="0" />
            <input type="hidden" name="Rep" value="1"/>
            <input type="hidden" name="Date" value="@d" />
            <button class="btn btn-success">
                + Ajouter une série
            </button>
        </form>
        <form asp-action="DeleteExercice" method="post">
            <input type="hidden" name="exo" value="@Model[i].ExerciceId" />
            <input type="hidden" name="pageIndex" value="@Model[0].NomSeanceId" />
            <button role="button" class="btn btn-danger">
                Supprimer cet exercice
            </button>
        </form>
        </div>
    }
}
@section Scripts {
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function openForm(id) {
            $.ajax({
                url: '@Url.Action("EditSeance", "Seance")' + '?id=' + id,
                type: 'GET',
                success: function(html) {
                    $('#formContainer').html(html);
                    $('#formModal').modal('show');
                },
                error: function() {
                    alert('Une erreur est survenue lors du chargement du formulaire.');
                }
            });
        }
    </script>
    <script>
        function AddExo(id) {
            $.ajax({
                url: '@Url.Action("AddExercice", "Seance")' + '?id=' + id,
                type: 'GET',
                success: function(html) {
                    $('#formContainer').html(html);
                    $('#formModal').modal('show');
                },
                error: function() {
                    alert('Une erreur est survenue lors du chargement du formulaire.');
                }
            });
        }
    </script>
}