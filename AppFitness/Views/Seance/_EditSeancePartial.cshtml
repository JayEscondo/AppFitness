@using EntitiesFitness
@model Serie

<div class="modal-header">
    <h1 class="text-white text-center">@ViewBag.Message</h1>
</div>
<div class="modal-body">
<form class="pt-4 btn-color3 text-center" asp-action="EditSeance" method="post">
    <table>
      <thead>
          <tr>
            <th>N° série</th>
            <th>Poids(kg)</th>
            <th>Nb répétitions</th>
        </tr>
      </thead>
      <tbody>
          <input type="hidden" name="pageIndex" value="@ViewBag.Message1" />
          <tr>
            <input type="hidden" asp-for="@Model.Id" value="@Model.Id" />
            <td><input class="form-control mb-3" type="number" name="numSerie" value="@ViewBag.NumSerie" /></td>
            <td>
                <input class="form-control mb-3" type="number"
                asp-for="Poids"
                value=@Model.Poids" />
            </td>
            <td>
                <input class="form-control mb-3" type="number"
                asp-for="Rep"
                value="@Model.Rep" />
            </td>
          </tr>
      </tbody>
    </table>
    <br/>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    <br/>
</form>
</div>