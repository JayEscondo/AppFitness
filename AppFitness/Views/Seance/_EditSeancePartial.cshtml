@using EntitiesFitness
@model Seance

<div class="modal-header">
    <h1 class="text-white">EditSeance</h1>
</div>
<div class="modal-body">
<form class="p-4 rounded-3 btn-color3" asp-action="EditSeance" method="post" id="">
    <div>
        <label class="text-white">Nom</label>
        <input class="form-control"  type="text" />
        <span class="text-danger"></span>
    </div>
    <br />
    <div>
        <label class="text-white">Muscle</label>
        <select class="form-select" asp-items="@ViewBag.listeMuscle">
            <option value="">-- Choisir un muscle --</option>
        </select>
        <span class="text-danger"></span>
    </div>
    <br />
    <div>
        <button type="submit" class="btn btn-primary">Enregistrer</button>
    </div>
</form>
</div>