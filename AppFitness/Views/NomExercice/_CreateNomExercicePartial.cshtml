@using EntitiesFitness
@model NomExercice

<h1>Page CreateNomExercice</h1>
<form id="formCreateNomExercice" asp-action="CreateNomExercice" method="post">
    <div>
        <label asp-for="Nom">Nom</label>
        <input asp-for="Nom" type="text" />
        <span asp-validation-for="Nom" class="text-danger"></span>
    </div>
    <div>
        <label asp-for="MuscleId">Muscle</label>
        <select asp-for="MuscleId" asp-items="@ViewBag.listeMuscle">
            <option value="">-- Choisir un muscle --</option>
        </select>
        <span asp-validation-for="MuscleId" class="text-danger"></span>
    </div>
    <input type="hidden" asp-for="Muscle" value="sac" />
    <button class="btn btn-primary" type="submit">Enregistrer</button>
    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Annuler</button>
</form>
